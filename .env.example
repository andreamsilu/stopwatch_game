# Copy this file to `.env` in the project root (`.env` is gitignored).

API_BASE_URL=http://188.64.189.38:9090

API_PREFIX=/api/v1



# Start session channel (POST /game/start)

# Must be APP, SMS, or WEB (case-insensitive in app; sent uppercase to API)
GAME_CHANNEL=WEB



# Poll GET /billing/transactions/{requestId} after enqueue (ms)

BILLING_POLL_INTERVAL_MS=2000

BILLING_POLL_TIMEOUT_MS=30000



# Log all backend HTTP request/response bodies to the debug console

API_LOG_RESPONSES=true



# HMAC signing (must match backend stopwatch.security.hmac.*)

# When true, all /api/v1/** calls (except auth login/verify) send X-TIMESTAMP, X-NONCE, X-SIGNATURE.
# Flutter loads .env from assets (pubspec). After editing, fully stop and re-run the app;
# on web also rebuild (`flutter build web`). Stale build/flutter_assets/.env keeps old values.

STOPWATCH_SECURITY_HMAC_ENABLED=false

STOPWATCH_SECURITY_HMAC_SECRET=



# Social profile URLs (leave blank to hide a platform; Facebook is always listed when set)

SOCIAL_FACEBOOK_URL=https://www.facebook.com/

SOCIAL_INSTAGRAM_URL=

SOCIAL_X_URL=

SOCIAL_YOUTUBE_URL=

