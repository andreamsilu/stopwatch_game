# Copy this file to `.env` in the project root (`.env` is gitignored).
API_BASE_URL=http://188.64.189.38:9090
API_PREFIX=/api/v1

# Auth: true = mock OTP 123456; false = live GET/POST /api/v1/users
MOCK_AUTH=false

# Game: true = local mock APIs. false = real game endpoints.
MOCK_GAME=false

# Start session channel (POST /game/start)
GAME_CHANNEL=SMS

# Mock billing id when MOCK_GAME=true
MOCK_BILLING_REQUEST_ID=mock-billing-request

# Entry fee sent to POST /billing/transactions when user taps Play
GAME_ENTRY_FEE=0.01

# Poll GET /billing/transactions/{requestId} after enqueue (ms)
BILLING_POLL_INTERVAL_MS=2000
BILLING_POLL_TIMEOUT_MS=120000
